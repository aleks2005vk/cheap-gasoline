# Environment Configuration for Cheap Gasoline - Frontend

# API Configuration
# LOCAL: Use http://localhost:8001 for development
# PRODUCTION: Use your deployed backend URL (e.g., https://cheap-gasoline-api.railway.app)
VITE_API_URL=http://localhost:8001
VITE_BACKEND_URL=http://localhost:8001
VITE_ENV=production

# VERCEL SETUP INSTRUCTIONS:
# 1. Go to https://vercel.com/dashboard
# 2. Select "cheap-gasoline" project
# 3. Go to Settings → Environment Variables
# 4. Add: VITE_API_URL = your_backend_url
# 5. Example: https://your-backend.railway.app or similar

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Map Configuration
VITE_MAP_TOKEN=your_mapbox_token_here
VITE_MAP_CENTER_LAT=41.7151
VITE_MAP_CENTER_LNG=44.7671

# Feature Flags
VITE_ENABLE_CLUSTERING=true
VITE_ENABLE_ROUTING=true
